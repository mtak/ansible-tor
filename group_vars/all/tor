---

tor_data_fudge_factor: 0.9

tor_exit_ports:
  - 53
  - 80
  - 443
# IMAPS
  - 993
# POP3S
  - 995
# OpenVPN
  - 1194
# OpenPGP HKP
  - 11371

tor_blocked_hosts:
  - 192.168.0.1

tor_metrics_port: 9098

# Public values from the same Tor-generated family key. Keep the binary key
# outside this repository and set TOR_FAMILY_KEY_FILE to its absolute path.
# An empty value makes the deployment preflight fail until the operator
# supplies the real values.
tor_family_id: ""
tor_family_key_sha256: ""

# If data is unlimited:
tor_bandwidth: 600       # in Mbit/s
tor_bandwidth_burst: 800 # in Mbit/s

